{
  "compilerOptions": {
    "target": "ES2023",
   "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "strict": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "modules/**/*.ts",
    "test/**/*.ts",
    "vitest*.ts"
  ]
}
